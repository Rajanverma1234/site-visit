# ─── The Sovereign — environment variables ───────────────────────────────────
# Copy to .env.local for local development; set the same keys in
# Vercel → Project → Settings → Environment Variables for deployments.

# Demo vs live mode. Default (unset) = true:
#   true  → noindex/nofollow + robots.txt disallows all + demo disclaimers shown
#   false → indexable, sitemap advertised, disclaimers hidden
NEXT_PUBLIC_IS_DEMO=true

# Canonical site URL (used for share links, sitemap, structured data). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://site-visit-wcr.vercel.app

# Lead emails via Resend (https://resend.com). Leave empty to just log leads on the server.
RESEND_API_KEY=
# Where leads are sent (comma-separated for several recipients)
LEAD_TO_EMAIL=
# Verified sender in Resend, e.g. "The Sovereign <leads@yourdomain.com>"
LEAD_FROM_EMAIL=
